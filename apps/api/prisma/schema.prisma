generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE

  @@map("restaurant_status")
}

enum TablePhysicalStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  OUT_OF_SERVICE

  @@map("table_physical_status")
}

enum MenuCategoryStatus {
  ACTIVE
  INACTIVE

  @@map("menu_category_status")
}

enum MenuItemStatus {
  ACTIVE
  INACTIVE

  @@map("menu_item_status")
}

enum FulfillmentStation {
  KITCHEN
  BAR
  DIRECT

  @@map("fulfillment_station")
}

enum StaffUserStatus {
  ACTIVE
  INACTIVE

  @@map("staff_user_status")
}

enum StaffMembershipStatus {
  ACTIVE
  INACTIVE
  REVOKED

  @@map("staff_membership_status")
}

enum GuestAccessLevel {
  BROWSE_ONLY
  ORDER_ENABLED

  @@map("guest_access_level")
}

enum ActivationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED

  @@map("activation_request_status")
}

enum IdempotencyActorType {
  GUEST_SESSION
  STAFF_MEMBERSHIP

  @@map("idempotency_actor_type")
}

enum IdempotencyRecordStatus {
  COMPLETED

  @@map("idempotency_record_status")
}

enum TableSessionStatus {
  ACTIVE
  CHECKOUT_LOCKED
  CLOSED
  CANCELLED

  @@map("table_session_status")
}

enum BillStatus {
  OPEN
  PAYMENT_PENDING
  SETTLED
  VOID

  @@map("bill_status")
}

enum AuditActorType {
  STAFF_MEMBERSHIP
  GUEST_SESSION

  @@map("audit_actor_type")
}

enum JoinRateLimitDimension {
  GUEST_TABLE
  IP_TABLE
  TABLE_SESSION

  @@map("join_rate_limit_dimension")
}

model Restaurant {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @db.VarChar(160)
  status             RestaurantStatus    @default(ACTIVE)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  locations          Location[]
  staffMemberships   StaffMembership[]
  roles              Role[]
  activationRequests ActivationRequest[]
  idempotencyRecords IdempotencyRecord[]
  tableSessions      TableSession[]
  bills              Bill[]
  outboxEvents       OutboxEvent[]
  auditLogs          AuditLog[]
  sessionJoinCodes   SessionJoinCode[]

  @@map("restaurant")
}

model Location {
  id                 String              @id @default(uuid()) @db.Uuid
  restaurantId       String              @map("restaurant_id") @db.Uuid
  code               String              @db.VarChar(32)
  name               String              @db.VarChar(160)
  timezone           String              @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  currency           String              @default("VND") @db.Char(3)
  isActive           Boolean             @default(false) @map("is_active")
  restaurant         Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tables             RestaurantTable[]
  categories         MenuCategory[]
  staffMemberships   StaffMembership[]
  activationRequests ActivationRequest[]
  tableSessions      TableSession[]
  bills              Bill[]
  outboxEvents       OutboxEvent[]
  auditLogs          AuditLog[]
  sessionJoinCodes   SessionJoinCode[]

  @@unique([id, restaurantId], map: "location_id_restaurant_id_key")
  @@unique([restaurantId, code], map: "location_restaurant_id_code_key")
  @@map("location")
}

model StaffUser {
  id           String            @id @default(uuid()) @db.Uuid
  email        String            @unique(map: "staff_user_email_key") @db.VarChar(320)
  passwordHash String            @map("password_hash") @db.VarChar(255)
  name         String            @db.VarChar(160)
  status       StaffUserStatus   @default(ACTIVE)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships  StaffMembership[]
  sessions     StaffSession[]

  @@map("staff_user")
}

model StaffMembership {
  id                        String                @id @default(uuid()) @db.Uuid
  staffUserId               String                @map("staff_user_id") @db.Uuid
  restaurantId              String                @map("restaurant_id") @db.Uuid
  locationId                String                @map("location_id") @db.Uuid
  status                    StaffMembershipStatus @default(ACTIVE)
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  staffUser                 StaffUser             @relation(fields: [staffUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  restaurant                Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  location                  Location              @relation(fields: [locationId, restaurantId], references: [id, restaurantId], onDelete: Restrict, onUpdate: Cascade)
  roles                     MembershipRole[]
  sessions                  StaffSession[]
  handledActivationRequests ActivationRequest[]
  activatedTableSessions    TableSession[]        @relation("TableSessionActivatedBy")
  closedTableSessions       TableSession[]        @relation("TableSessionClosedBy")
  createdSessionJoinCodes   SessionJoinCode[]

  @@unique([staffUserId, locationId], map: "staff_membership_user_location_key")
  @@unique([id, staffUserId], map: "staff_membership_id_user_key")
  @@unique([id, restaurantId], map: "staff_membership_id_restaurant_key")
  @@unique([id, restaurantId, locationId], map: "staff_membership_id_scope_key")
  @@index([locationId, status], map: "staff_membership_location_status_idx")
  @@map("staff_membership")
}

model Role {
  id           String           @id @default(uuid()) @db.Uuid
  restaurantId String           @map("restaurant_id") @db.Uuid
  code         String           @db.VarChar(64)
  name         String           @db.VarChar(120)
  isSystem     Boolean          @default(false) @map("is_system")
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  memberships  MembershipRole[]
  permissions  RolePermission[]

  @@unique([restaurantId, code], map: "role_restaurant_code_key")
  @@unique([id, restaurantId], map: "role_id_restaurant_key")
  @@map("role")
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  code  String           @unique(map: "permission_code_key") @db.VarChar(96)
  roles RolePermission[]

  @@map("permission")
}

model MembershipRole {
  membershipId String          @map("membership_id") @db.Uuid
  roleId       String          @map("role_id") @db.Uuid
  restaurantId String          @map("restaurant_id") @db.Uuid
  membership   StaffMembership @relation(fields: [membershipId, restaurantId], references: [id, restaurantId], onDelete: Restrict, onUpdate: Cascade)
  role         Role            @relation(fields: [roleId, restaurantId], references: [id, restaurantId], onDelete: Restrict, onUpdate: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId], map: "membership_role_role_id_idx")
  @@map("membership_role")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permission_permission_id_idx")
  @@map("role_permission")
}

model StaffSession {
  id            String          @id @default(uuid()) @db.Uuid
  staffUserId   String          @map("staff_user_id") @db.Uuid
  membershipId  String          @map("membership_id") @db.Uuid
  tokenHash     String          @unique(map: "staff_session_token_hash_key") @map("token_hash") @db.Char(64)
  csrfTokenHash String          @map("csrf_token_hash") @db.Char(64)
  expiresAt     DateTime        @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?       @map("revoked_at") @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  staffUser     StaffUser       @relation(fields: [staffUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  membership    StaffMembership @relation(fields: [membershipId, staffUserId], references: [id, staffUserId], onDelete: Restrict, onUpdate: Cascade)

  @@index([membershipId, expiresAt], map: "staff_session_membership_expiry_idx")
  @@map("staff_session")
}

model RestaurantTable {
  id                 String              @id @default(uuid()) @db.Uuid
  restaurantId       String              @map("restaurant_id") @db.Uuid
  locationId         String              @map("location_id") @db.Uuid
  publicId           String              @unique(map: "restaurant_table_public_id_key") @default(uuid()) @map("public_id") @db.Uuid
  code               String              @db.VarChar(32)
  capacity           Int
  physicalStatus     TablePhysicalStatus @default(AVAILABLE) @map("physical_status")
  version            Int                 @default(0)
  isActive           Boolean             @default(true) @map("is_active")
  location           Location            @relation(fields: [locationId, restaurantId], references: [id, restaurantId], onDelete: Restrict, onUpdate: Cascade)
  guestSessions      GuestSession[]
  activationRequests ActivationRequest[]
  tableSessions      TableSession[]
  sessionJoinCodes   SessionJoinCode[]

  @@unique([id, restaurantId, locationId], map: "restaurant_table_id_scope_key")
  @@unique([locationId, code], map: "restaurant_table_location_id_code_key")
  @@index([locationId, physicalStatus], map: "restaurant_table_location_status_idx")
  @@map("restaurant_table")
}

model MenuCategory {
  id           String             @id @default(uuid()) @db.Uuid
  restaurantId String             @map("restaurant_id") @db.Uuid
  locationId   String             @map("location_id") @db.Uuid
  name         String             @db.VarChar(120)
  displayOrder Int                @map("display_order")
  status       MenuCategoryStatus @default(ACTIVE)
  location     Location           @relation(fields: [locationId, restaurantId], references: [id, restaurantId], onDelete: Restrict, onUpdate: Cascade)
  items        MenuItem[]

  @@unique([id, restaurantId, locationId], map: "menu_category_id_scope_key")
  @@index([locationId, status, displayOrder], map: "menu_category_location_status_order_idx")
  @@map("menu_category")
}

model MenuItem {
  id                 String             @id @default(uuid()) @db.Uuid
  restaurantId       String             @map("restaurant_id") @db.Uuid
  locationId         String             @map("location_id") @db.Uuid
  categoryId         String             @map("category_id") @db.Uuid
  name               String             @db.VarChar(160)
  description        String?            @db.Text
  priceAmount        BigInt             @map("price_amount")
  fulfillmentStation FulfillmentStation @map("fulfillment_station")
  status             MenuItemStatus     @default(ACTIVE)
  version            Int                @default(0)
  category           MenuCategory       @relation(fields: [categoryId, restaurantId, locationId], references: [id, restaurantId, locationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, restaurantId, locationId], map: "menu_item_id_scope_key")
  @@index([categoryId, status], map: "menu_item_category_status_idx")
  @@map("menu_item")
}

model GuestSession {
  id                      String              @id @default(uuid()) @db.Uuid
  restaurantId            String              @map("restaurant_id") @db.Uuid
  locationId              String              @map("location_id") @db.Uuid
  tableId                 String              @map("table_id") @db.Uuid
  tableSessionId          String?             @map("table_session_id") @db.Uuid
  tokenHash               String              @unique(map: "guest_session_token_hash_key") @map("token_hash") @db.Char(64)
  csrfTokenHash           String              @map("csrf_token_hash") @db.Char(64)
  previousTokenHash       String?             @unique(map: "guest_session_previous_token_hash_key") @map("previous_token_hash") @db.Char(64)
  previousCsrfTokenHash   String?             @map("previous_csrf_token_hash") @db.Char(64)
  previousTokenValidUntil DateTime?           @map("previous_token_valid_until") @db.Timestamptz(3)
  accessLevel             GuestAccessLevel    @default(BROWSE_ONLY) @map("access_level")
  idleExpiresAt           DateTime            @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt       DateTime            @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt               DateTime?           @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt              DateTime            @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  version                 Int                 @default(0)
  table                   RestaurantTable     @relation(fields: [tableId, restaurantId, locationId], references: [id, restaurantId, locationId], onDelete: Restrict, onUpdate: Cascade)
  tableSession            TableSession?       @relation(fields: [tableSessionId, restaurantId, locationId, tableId], references: [id, restaurantId, locationId, tableId], onDelete: Restrict, onUpdate: Cascade, map: "guest_session_table_session_scope_fkey")
  activationRequests      ActivationRequest[]
  createdSessionJoinCodes SessionJoinCode[]

  @@unique([id, restaurantId, locationId, tableId], map: "guest_session_id_scope_key")
  @@index([tableId, accessLevel], map: "guest_session_table_access_level_idx")
  @@index([tableId, idleExpiresAt], map: "guest_session_table_idle_expiry_idx")
  @@map("guest_session")
}

model ActivationRequest {
  id                      String                  @id @default(uuid()) @db.Uuid
  restaurantId            String                  @map("restaurant_id") @db.Uuid
  locationId              String                  @map("location_id") @db.Uuid
  tableId                 String                  @map("table_id") @db.Uuid
  requesterGuestSessionId String                  @map("requester_guest_session_id") @db.Uuid
  status                  ActivationRequestStatus @default(PENDING)
  expiresAt               DateTime                @map("expires_at") @db.Timestamptz(3)
  handledByMembershipId   String?                 @map("handled_by_membership_id") @db.Uuid
  handledAt               DateTime?               @map("handled_at") @db.Timestamptz(3)
  rejectionReason         String?                 @map("rejection_reason") @db.Text
  version                 Int                     @default(0)
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  restaurant              Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  location                Location                @relation(fields: [locationId, restaurantId], references: [id, restaurantId], onDelete: Restrict, onUpdate: Cascade)
  table                   RestaurantTable         @relation(fields: [tableId, restaurantId, locationId], references: [id, restaurantId, locationId], onDelete: Restrict, onUpdate: Cascade, map: "activation_request_table_id_scope_fkey")
  requesterGuestSession   GuestSession            @relation(fields: [requesterGuestSessionId, restaurantId, locationId, tableId], references: [id, restaurantId, locationId, tableId], onDelete: Restrict, onUpdate: Cascade, map: "activation_request_requester_scope_fkey")
  handledByMembership     StaffMembership?        @relation(fields: [handledByMembershipId, restaurantId, locationId], references: [id, restaurantId, locationId], onDelete: Restrict, onUpdate: Cascade, map: "activation_request_handler_scope_fkey")
  tableSession            TableSession?

  @@unique([id, restaurantId, locationId, tableId], map: "activation_request_id_scope_key")
  @@index([locationId, status, createdAt], map: "activation_request_location_status_created_idx")
  @@index([tableId, expiresAt], map: "activation_request_table_expiry_idx")
  @@index([requesterGuestSessionId, createdAt], map: "activation_request_requester_created_idx")
  @@map("activation_request")
}

model IdempotencyRecord {
  id             String                  @id @default(uuid()) @db.Uuid
  restaurantId   String                  @map("restaurant_id") @db.Uuid
  actorType      IdempotencyActorType    @map("actor_type")
  actorId        String                  @map("actor_id") @db.Uuid
  operation      String                  @db.VarChar(64)
  idempotencyKey String                  @map("idempotency_key") @db.VarChar(128)
  requestHash    String                  @map("request_hash") @db.Char(64)
  status         IdempotencyRecordStatus @default(COMPLETED)
  responseStatus Int                     @map("response_status")
  responseBody   Json                    @map("response_body")
  resourceId     String?                 @map("resource_id") @db.Uuid
  expiresAt      DateTime                @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  restaurant     Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([actorType, actorId, operation, idempotencyKey], map: "idempotency_record_actor_operation_key")
  @@index([restaurantId, expiresAt], map: "idempotency_record_restaurant_expiry_idx")
  @@map("idempotency_record")
}

model TableSession {
  id                      String             @id @default(uuid()) @db.Uuid
  restaurantId            String             @map("restaurant_id") @db.Uuid
  locationId              String             @map("location_id") @db.Uuid
  tableId                 String             @map("table_id") @db.Uuid
  activationRequestId     String             @unique(map: "table_session_activation_request_id_key") @map("activation_request_id") @db.Uuid
  status                  TableSessionStatus @default(ACTIVE)
  activatedByMembershipId String             @map("activated_by_membership_id") @db.Uuid
  activatedAt             DateTime           @default(now()) @map("activated_at") @db.Timestamptz(3)
  checkoutLockedAt        DateTime?          @map("checkout_locked_at") @db.Timestamptz(3)
  closedByMembershipId    String?            @map("closed_by_membership_id") @db.Uuid
  closedAt                DateTime?          @map("closed_at") @db.Timestamptz(3)
  closeReason             String?            @map("close_reason") @db.Text
  version                 Int                @default(0)
  restaurant              Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "table_session_restaurant_fkey")
  location                Location           @relation(fields: [locationId, restaurantId], references: [id, restaurantId], onDelete: Restrict, onUpdate: Cascade, map: "table_session_location_scope_fkey")
  table                   RestaurantTable    @relation(fields: [tableId, restaurantId, locationId], references: [id, restaurantId, locationId], onDelete: Restrict, onUpdate: Cascade, map: "table_session_table_scope_fkey")
  activationRequest       ActivationRequest  @relation(fields: [activationRequestId, restaurantId, locationId, tableId], references: [id, restaurantId, locationId, tableId], onDelete: Restrict, onUpdate: Cascade, map: "table_session_activation_scope_fkey")
  activatedByMembership   StaffMembership    @relation("TableSessionActivatedBy", fields: [activatedByMembershipId, restaurantId, locationId], references: [id, restaurantId, locationId], onDelete: Restrict, onUpdate: Cascade, map: "table_session_activator_scope_fkey")
  closedByMembership      StaffMembership?   @relation("TableSessionClosedBy", fields: [closedByMembershipId, restaurantId, locationId], references: [id, restaurantId, locationId], onDelete: Restrict, onUpdate: Cascade, map: "table_session_closer_scope_fkey")
  guestSessions           GuestSession[]
  bill                    Bill?
  joinCodes               SessionJoinCode[]
  joinAttemptRateLimits   JoinAttemptRateLimit[]

  @@unique([id, restaurantId, locationId], map: "table_session_id_location_scope_key")
  @@unique([id, restaurantId, locationId, tableId], map: "table_session_id_table_scope_key")
  @@unique([activationRequestId, restaurantId, locationId, tableId], map: "table_session_activation_scope_key")
  @@index([locationId, status, activatedAt], map: "table_session_location_status_activated_idx")
  @@map("table_session")
}

model SessionJoinCode {
  id                          String           @id @default(uuid()) @db.Uuid
  restaurantId                String           @map("restaurant_id") @db.Uuid
  locationId                  String           @map("location_id") @db.Uuid
  tableId                     String           @map("table_id") @db.Uuid
  tableSessionId              String           @map("table_session_id") @db.Uuid
  codeHash                    String           @map("code_hash") @db.Char(64)
  expiresAt                   DateTime         @map("expires_at") @db.Timestamptz(3)
  revokedAt                   DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdByGuestSessionId     String?          @map("created_by_guest_session_id") @db.Uuid
  createdByMembershipId       String?          @map("created_by_membership_id") @db.Uuid
  createdAt                   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  restaurant                  Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  location                    Location         @relation(fields: [locationId, restaurantId], references: [id, restaurantId], onDelete: Restrict, onUpdate: Cascade)
  table                       RestaurantTable  @relation(fields: [tableId, restaurantId, locationId], references: [id, restaurantId, locationId], onDelete: Restrict, onUpdate: Cascade)
  tableSession                TableSession     @relation(fields: [tableSessionId, restaurantId, locationId, tableId], references: [id, restaurantId, locationId, tableId], onDelete: Restrict, onUpdate: Cascade)
  createdByGuestSession       GuestSession?    @relation(fields: [createdByGuestSessionId, restaurantId, locationId, tableId], references: [id, restaurantId, locationId, tableId], onDelete: Restrict, onUpdate: Cascade)
  createdByMembership         StaffMembership? @relation(fields: [createdByMembershipId, restaurantId, locationId], references: [id, restaurantId, locationId], onDelete: Restrict, onUpdate: Cascade)

  @@index([tableSessionId, expiresAt], map: "session_join_code_session_expiry_idx")
  @@index([tableId, expiresAt], map: "session_join_code_table_expiry_idx")
  @@map("session_join_code")
}

model JoinAttemptRateLimit {
  id               String                 @id @default(uuid()) @db.Uuid
  restaurantId     String                 @map("restaurant_id") @db.Uuid
  locationId       String                 @map("location_id") @db.Uuid
  tableId          String                 @map("table_id") @db.Uuid
  tableSessionId   String                 @map("table_session_id") @db.Uuid
  dimension        JoinRateLimitDimension
  subjectHash      String                 @map("subject_hash") @db.Char(64)
  windowStartedAt  DateTime               @map("window_started_at") @db.Timestamptz(3)
  failedAttempts   Int                    @default(0) @map("failed_attempts")
  blockedUntil     DateTime?              @map("blocked_until") @db.Timestamptz(3)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tableSession     TableSession           @relation(fields: [tableSessionId, restaurantId, locationId, tableId], references: [id, restaurantId, locationId, tableId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tableSessionId, dimension, subjectHash], map: "join_rate_limit_session_dimension_subject_key")
  @@index([tableSessionId, blockedUntil], map: "join_rate_limit_session_blocked_idx")
  @@map("join_attempt_rate_limit")
}

model Bill {
  id               String       @id @default(uuid()) @db.Uuid
  restaurantId     String       @map("restaurant_id") @db.Uuid
  locationId       String       @map("location_id") @db.Uuid
  tableSessionId   String       @unique(map: "bill_table_session_id_key") @map("table_session_id") @db.Uuid
  status           BillStatus   @default(OPEN)
  subtotalAmount   BigInt       @default(0) @map("subtotal_amount")
  adjustmentAmount BigInt       @default(0) @map("adjustment_amount")
  totalAmount      BigInt       @default(0) @map("total_amount")
  paidAmount       BigInt       @default(0) @map("paid_amount")
  balanceAmount    BigInt       @default(0) @map("balance_amount")
  version          Int          @default(0)
  restaurant       Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "bill_restaurant_fkey")
  location         Location     @relation(fields: [locationId, restaurantId], references: [id, restaurantId], onDelete: Restrict, onUpdate: Cascade, map: "bill_location_scope_fkey")
  tableSession     TableSession @relation(fields: [tableSessionId, restaurantId, locationId], references: [id, restaurantId, locationId], onDelete: Restrict, onUpdate: Cascade, map: "bill_table_session_scope_fkey")

  @@unique([tableSessionId, restaurantId, locationId], map: "bill_table_session_scope_key")
  @@index([locationId, status], map: "bill_location_status_idx")
  @@map("bill")
}

model OutboxEvent {
  id            String     @id @default(uuid()) @db.Uuid
  restaurantId  String     @map("restaurant_id") @db.Uuid
  locationId    String     @map("location_id") @db.Uuid
  aggregateType String     @map("aggregate_type") @db.VarChar(64)
  aggregateId   String     @map("aggregate_id") @db.Uuid
  eventType     String     @map("event_type") @db.VarChar(96)
  payload       Json
  occurredAt    DateTime   @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime?  @map("published_at") @db.Timestamptz(3)
  attemptCount  Int        @default(0) @map("attempt_count")
  nextAttemptAt DateTime?  @map("next_attempt_at") @db.Timestamptz(3)
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "outbox_event_restaurant_fkey")
  location      Location   @relation(fields: [locationId, restaurantId], references: [id, restaurantId], onDelete: Restrict, onUpdate: Cascade, map: "outbox_event_location_scope_fkey")

  @@index([aggregateType, aggregateId, occurredAt], map: "outbox_event_aggregate_occurred_idx")
  @@map("outbox_event")
}

model AuditLog {
  id           String         @id @default(uuid()) @db.Uuid
  restaurantId String         @map("restaurant_id") @db.Uuid
  locationId   String         @map("location_id") @db.Uuid
  actorType    AuditActorType @map("actor_type")
  actorId      String         @map("actor_id") @db.Uuid
  action       String         @db.VarChar(96)
  resourceType String         @map("resource_type") @db.VarChar(64)
  resourceId   String         @map("resource_id") @db.Uuid
  reason       String?        @db.Text
  metadata     Json
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "audit_log_restaurant_fkey")
  location     Location       @relation(fields: [locationId, restaurantId], references: [id, restaurantId], onDelete: Restrict, onUpdate: Cascade, map: "audit_log_location_scope_fkey")

  @@index([restaurantId, locationId, createdAt], map: "audit_log_scope_created_idx")
  @@index([resourceType, resourceId, createdAt], map: "audit_log_resource_created_idx")
  @@index([actorType, actorId, createdAt], map: "audit_log_actor_created_idx")
  @@map("audit_log")
}
