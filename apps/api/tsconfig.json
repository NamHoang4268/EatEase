{
  "extends": "@eatease/tsconfig/node.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "prisma7.config.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts"
  ]
}
